# HTTPS automatique (Let's Encrypt). DOMAIN=ecommarket.africa
{$DOMAIN}, www.{$DOMAIN} {
	encode zstd gzip
	@www host www.{$DOMAIN}
	redir @www https://{$DOMAIN}{uri} permanent

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	@static path /_next/static/* /uploads/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	request_body {
		max_size 40MB
	}
	reverse_proxy app:3000
}

# Médias (MinIO, bucket public en lecture) : S3_PUBLIC_URL=https://{$MEDIA_DOMAIN}/ecom-media
{$MEDIA_DOMAIN} {
	encode gzip
	header Cache-Control "public, max-age=31536000, immutable"
	reverse_proxy minio:9000
}
