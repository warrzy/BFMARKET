# ── Base ──────────────────────────────────────────────
DATABASE_URL="postgresql://ecom:ecom@localhost:5432/ecom?schema=public"
APP_URL="http://localhost:3000"
# Chaîne aléatoire >= 32 caractères (openssl rand -hex 32)
SESSION_SECRET=""
# Numéro WhatsApp du support plateforme (E.164 sans +), ex. 22670000000
SUPPORT_WHATSAPP=""

# ── Stockage des fichiers ─────────────────────────────
# local (public/uploads) ou s3 (MinIO, Scaleway, AWS, Wasabi…)
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_URL=""

# ── Redis (optionnel : limitation de débit, files) ────
REDIS_URL=""

# ── Envoi des codes de vérification ───────────────────
# console (dev) | webhook (votre passerelle SMS/e-mail)
OTP_DELIVERY="console"
OTP_WEBHOOK_URL=""

# ── Paiements (laisser vide = prestataire indisponible) ──
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET_KEY=""
PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_TOKEN=""

# ── Assistant IA (optionnel) ──────────────────────────
ANTHROPIC_API_KEY=""
AI_MODEL="claude-haiku-5-5"

# ── Sous-domaines boutiques (évolution) ───────────────
SHOP_SUBDOMAINS_ENABLED="false"
ROOT_DOMAIN="ecommarket.africa"

# ── Tâches planifiées ─────────────────────────────────
# Secret pour POST /api/cron/subscriptions (rappels, expiration des abonnements)
CRON_SECRET=""

# ── Préproduction / tests E2E uniquement (NE JAMAIS activer en production réelle) ──
OTP_CONSOLE_IN_PRODUCTION="false"
OTP_SHOW_ON_SCREEN="false"

# ── Préproduction : interdit l'indexation (robots.txt, meta, X-Robots-Tag) ──
SITE_NOINDEX="false"
